<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Models live in noBackupFilesDir. These exclusions also protect future file-domain moves. -->
        <exclude domain="root" path="models/" />
        <exclude domain="file" path="models/" />
        <exclude domain="sharedpref" path="campus_ai_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="models/" />
        <exclude domain="file" path="models/" />
        <exclude domain="sharedpref" path="campus_ai_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
