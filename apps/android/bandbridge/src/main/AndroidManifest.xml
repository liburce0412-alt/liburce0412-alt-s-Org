<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="com.campusai.caesar.bandbridge.permission.READ_LIVE"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="nodomain.freeyourgadget.gadgetbridge" />
        <package android:name="nodomain.freeyourgadget.gadgetbridge.nightly" />
        <package android:name="nodomain.freeyourgadget.gadgetbridge.nightly_nopebble" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Caesar Band Bridge"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false">
        <provider
            android:name=".BandSnapshotProvider"
            android:authorities="com.campusai.caesar.bandbridge.live"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="com.campusai.caesar.bandbridge.permission.READ_LIVE" />

        <service
            android:name=".BandBridgeService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice"
            android:permission="com.campusai.caesar.bandbridge.permission.READ_LIVE"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="com.campusai.caesar.bandbridge.action.START_LIVE" />
                <action android:name="com.campusai.caesar.bandbridge.action.STOP_LIVE" />
                <action android:name="com.campusai.caesar.bandbridge.action.TRIGGER_HISTORY_SYNC" />
            </intent-filter>
        </service>

        <activity
            android:name=".BandBridgeDiagnosticsActivity"
            android:exported="true"
            android:permission="com.campusai.caesar.bandbridge.permission.READ_LIVE" />
    </application>
</manifest>
